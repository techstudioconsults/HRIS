#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Use base branch from Husky env (HUSKY_GIT_PARAMS); fallback to origin/main
BASE_BRANCH="origin/main"

git pull origin main

pnpm turbo run typecheck --filter=[$BASE_BRANCH...HEAD] || {
  echo "Type checking failed — run 'pnpm typecheck' locally to see full output"
  exit 1
}
